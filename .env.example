VITE_API_BASE_URL=http://localhost:8080

# Optional — the app runs fine without it, errors just aren't reported
# anywhere. Create a project at https://sentry.io and paste its DSN here.
VITE_SENTRY_DSN=

# Optional, build-time only — deliberately NOT prefixed VITE_, so unlike the
# vars above these are never inlined into the shipped client bundle. Set
# these in the Netlify build environment (not just any env) to upload this
# build's source maps to Sentry, so production stack traces are readable
# instead of minified. Without SENTRY_AUTH_TOKEN, vite.config.js's Sentry
# plugin is a complete no-op — no sourcemaps generated, no network calls.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Not something to set here — vite.config.js derives it automatically at
# build time (Netlify's COMMIT_REF, or the local git SHA, or package.json's
# version as a last resort) and inlines it as import.meta.env.VITE_APP_VERSION.
# It's what tags each Sentry event with the release that produced it, and
# matches the release name the sourcemap upload above uses, so a production
# stack trace resolves back to real source. Documented here only so it's not
# a mystery when you see it in src/sentry.js or a Sentry event.
