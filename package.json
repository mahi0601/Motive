{
  "name": "motive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/clean-sourcemaps.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "android": "vite build && cap sync && cap open android",
    "apk": "vite build && cap sync android && cd android && ./gradlew assembleRelease && echo '\\nAPK: android/app/build/outputs/apk/release/app-release.apk'",
    "brand": "node scripts/generate-brand-assets.mjs",
    "brand:android": "npx --yes @capacitor/assets@3.0.5 generate --android --assetPath assets --iconBackgroundColor '#0E4C5C' --iconBackgroundColorDark '#0E4C5C' --splashBackgroundColor '#0E4C5C' --splashBackgroundColorDark '#0B1418'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@sentry/react": "^10.73.0",
    "axios": "^1.8.4",
    "chrono-node": "^2.10.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.483.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.21.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
